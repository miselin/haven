// continue and break use ordinary loop control and leave a snapshot alive.
pub impure fn sut_runtime_input(i32 value) -> i32;
fn find(fvec3 v) -> float {
    iter each value of v { if value > 1.0 { ret value; }; };
    -1.0
}
impure fn bound(i32* order, i32 digit, i32 value) -> i32 = {
    order := load order * 10 + digit;
    value
};
pub impure fn sut() -> i32 {
    let n = as<float>(sut_runtime_input(1));
    let values = Vec<n, (n + 1.0), (n + 2.0)>;
    let mut sum = 0.0;
    let mut visits = 0;
    iter each value of values {
        visits = visits + 1;
        if value == 2.0 { continue; };
        sum = sum + value;
    };
    if visits != 3 || sum != 4.0 { ret 1; };
    visits = 0;
    iter each value of values { visits = visits + 1; if value == 2.0 { break; }; };
    if visits != 2 || find(values) != 2.0 { ret 2; };
    let mut nested = 0;
    iter each outer of values { iter each inner of values { nested = nested + 1; break; }; };
    if nested != 3 { ret 3; };
    // The sentence form does not change existing range iteration.
    let in = 7;
    let mut range_total = 0;
    iter each index of 2:0:-1 { range_total = range_total + index; };
    if range_total != 3 || in != 7 { ret 4; };
    // Retain the legacy end, step, start evaluation order, each exactly once.
    let mut order = 0;
    range_total = 0;
    iter each i of bound(ref order, 1, 2):bound(ref order, 2, 4):bound(ref order, 3, 1) {
        range_total = range_total + i;
    };
    if order != 231 || range_total != 9 { ret 5; };
    order = 0;
    iter each i of bound(ref order, 1, 3):bound(ref order, 2, 2):bound(ref order, 3, 1) { ret 6; };
    if order != 231 { ret 7; };
    // Dynamic negative step, cached end/step values, continue and break.
    let mut end = 0;
    let mut step = sut_runtime_input(-1);
    visits = 0;
    range_total = 0;
    iter each i of 3:end:step {
        visits = visits + 1;
        end = 100;
        step = 1;
        if i == 2 { continue; };
        range_total = range_total + i;
        if i == 1 { break; };
    };
    if visits != 3 || range_total != 4 { ret 8; };
    visits = 0;
    iter each i of 4:4 { visits = visits + 1; };
    iter each i of 4:4:-1 { visits = visits + 1; };
    iter each i of 2:3:-1 { ret 9; };
    iter each i of 1:0:0 { ret 10; };
    if visits != 2 { ret 11; };
    // Boundary values terminate before an overflowing update; zero step is unchanged.
    iter each i of 2147483647:2147483647 { if i != 2147483647 { ret 12; }; break; };
    iter each i of -2147483648:-2147483648:-1 { if i != -2147483648 { ret 13; }; break; };
    visits = 0;
    iter each i of 4:4:0 { visits = visits + 1; break; };
    if visits != 1 { ret 14; };
    // The existing range counter remains mutable.
    range_total = 0;
    iter each i of 0:3 { i = i + 1; range_total = range_total + i; };
    if range_total != 4 { ret 15; };
    0
}
