// Generic lane/row widths must keep distinct generated analysis identities.
fn scale(fvec? v, float factor) = v * factor;
fn sum(fvec? v) -> float { let mut total = 0.0; iter each value of v { total = total + value; }; total }
fn total(mat? m) -> float {
    let mut result = 0.0;
    iter each row of m { result = result + sum(row); };
    result
}
fn transpose_into(mat? source, mat? destination) {
    @assert source.rows == destination.cols, "transpose columns";
    @assert source.cols == destination.rows, "transpose rows";
    let mut result = destination;
    iter each row of source indexed by r { iter each value of row indexed by c { result[c][r] = value; }; };
    result
}
fn ranged_sum(fvec? v, i32 step) -> float {
    let mut result = 0.0;
    iter each i of 0:(v.dim - 1):step { result = result + v[i]; };
    result
}
pub impure fn sut_runtime_input(i32 value) -> i32;
pub impure fn sut() -> i32 {
    if sum(Vec<7.0>) != 7.0 || sum(scale(Vec<1.0, 2.0>, 2.0)) != 6.0 || sum(Vec<3.0, 4.0, 5.0>) != 12.0 { ret 1; };
    let wide = Mat<Vec<1.0, 2.0, 3.0>, Vec<4.0, 5.0, 6.0>>;
    let tall = Mat<Vec<7.0, 8.0>, Vec<9.0, 10.0>, Vec<11.0, 12.0>>;
    if total(wide) != 21.0 || total(tall) != 57.0 { ret 2; };
    let mat3x2 tall_zero = zero;
    let mat2x3 wide_zero = zero;
    let a = transpose_into(wide, tall_zero);
    let b = transpose_into(tall, wide_zero);
    if a[0][1] != 4.0 || a[2][1] != 6.0 || b[0][2] != 11.0 || b[1][2] != 12.0 { ret 3; };
    let mut result = 0.0;
    iter each row of b indexed by r { iter each value of row indexed by c { result = result + value * as<float>(r + c); }; };
    if result != 95.0 { ret 4; };
    let step = sut_runtime_input(1);
    if ranged_sum(Vec<1.0, 2.0>, step) != 3.0 || ranged_sum(Vec<3.0, 4.0, 5.0>, step) != 12.0 { ret 5; };
    0
}
