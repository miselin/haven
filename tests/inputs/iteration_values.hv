// Source is evaluated once and copied, including row values and empty arrays.
impure fn source(i32* calls) -> fvec3 = { calls := load calls + 1; Vec<1.0, 2.0, 3.0> };
pub impure fn sut() -> i32 {
    let mut calls = 0;
    let mut order = 0;
    iter each value of source(ref calls) indexed by index {
        order = order * 10 + as<i32>(value);
        if index != as<u32>(value - 1.0) { ret 1; };
    };
    if calls != 1 || order != 123 { ret 2; };
    let mut original = Vec<1.0, 2.0, 3.0>;
    let mut sum = 0.0;
    iter each value of original indexed by index {
        sum = sum + value;
        original[2] = 100.0;
        original[index] = value * 2.0;
    };
    if sum != 6.0 || original.x != 2.0 || original.y != 4.0 || original.z != 6.0 { ret 3; };
    let mut matrix = Mat<Vec<1.0, 2.0, 3.0>, Vec<4.0, 5.0, 6.0>>;
    order = 0;
    iter each row of matrix indexed by row_index {
        let mut copy = row;
        copy[0] = 90.0;
        iter each value of row indexed by column { order = order * 10 + as<i32>(value); };
        matrix[1][0] = 99.0;
    };
    if order != 123456 || matrix[0][0] != 1.0 || matrix[1][0] != 99.0 { ret 4; };
    let mut i32[3] values = { 7, 8, 9 };
    order = 0;
    iter each value of values indexed by index { order = order * 10 + value; values[2] = 0; };
    if order != 789 { ret 5; };
    let i32[0] empty = zero;
    iter each value of { calls = calls + 1; empty } indexed by index { ret 6; };
    if calls != 2 { ret 7; };
    // Source lookup precedes the inner binding; values and ordinals do not escape.
    let value = Vec<4.0, 5.0>;
    let index = as<u32>(99);
    sum = 0.0;
    iter each value of value indexed by index { sum = sum + value; };
    if value.y != 5.0 || index != 99 || sum != 9.0 { ret 8; };
    let by = Vec<6.0, 7.0>;
    let mut indexed = 0.0;
    iter each value of by indexed /* contextual */ by ordinal { indexed = indexed + value * as<float>(ordinal); };
    if indexed != 7.0 { ret 9; };
    0
}
