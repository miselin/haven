// Expression bodies preserve eager calls, effects, short-circuiting and defer.
type Pair = struct { i32 first; i32 second; };
impure fn mark(i32* trace, i32 value) -> i32 = {
    trace := load trace * 10 + value;
    value
};
fn ignored(i32 argument) -> i32 = 7;
fn pair(i32 first, i32 second) -> Pair = { first, second };
impure fn short(i32* trace) -> i1 = 0 && mark(trace, 9);
impure fn choose(i32* trace, i32 condition) -> i32 = if condition { mark(trace, 3) } else { mark(trace, 4) };
impure fn deferred(i32* trace) -> i32 = { defer mark(trace, 5); mark(trace, 6) };
impure fn void_call(i32* trace) -> void { mark(trace, 8); }
fn plus_one(i32 value) -> i32 = value + 1;
fn plus_one_braced(i32 value) -> i32 { value + 1 }
pub fn plus_one_address() -> Function<(i32) -> i32> = plus_one;
pub impure fn sut() -> i32 {
    let mut trace = 0;
    if ignored(mark(ref trace, 1)) != 7 || trace != 1 { ret 1; };
    let p = pair(mark(ref trace, 2), mark(ref trace, 3));
    if trace != 123 || p.first != 2 || p.second != 3 { ret 2; };
    if short(ref trace) != 0 || trace != 123 { ret 3; };
    if choose(ref trace, 1) != 3 || trace != 1233 { ret 4; };
    if choose(ref trace, 0) != 4 || trace != 12334 { ret 5; };
    let before = trace;
    if deferred(ref trace) != 6 || trace != before * 100 + 65 { ret 6; };
    trace = 0;
    void_call(ref trace);
    if trace != 8 { ret 7; };
    let function = plus_one;
    if function(4) != 5 || plus_one_braced(4) != 5 { ret 8; };
    let escaped = plus_one_address();
    if escaped(10) != 11 { ret 9; };
    0
}
