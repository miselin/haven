// Same shape and element type, generic rows, nested maps and typed fill contexts.
data fvec3 FILLED = fill 2;
fn repeat(float value) -> fvec3 = fill value;
fn identity(fvec2 v) -> fvec2 = v;
fn filled(fvec? v) { let mut result = v; result = fill 1.0; result }
fn scaled(fvec? v) = map each x of v indexed by i { x * 2.0 + as<float>(i) };
fn nested(mat? m) = map each row of m { map each x of row { x + 1.0 } };
fn rows(mat? m) = map each row of m { row * 2.0 };
pub fn sut() -> i32 {
    let fvec3 a = fill (1.0 + 2.0);
    let mat2x3 b = fill -2.0;
    if a.x != 3.0 || a.z != 3.0 || b[0].z != -2.0 || b[1].x != -2.0 { ret 1; };
    if FILLED.y != 2.0 || repeat(4.0).z != 4.0 || identity(fill 5.0).y != 5.0 { ret 2; };
    let mut assigned = Vec<0.0, 0.0>;
    assigned = fill 6.0;
    if assigned.x != 6.0 || assigned.y != 6.0 { ret 3; };
    let integer_body = map each x of Vec<0.0, 0.0> { 7 };
    if integer_body.y != 7.0 { ret 9; };
    let c = scaled(Vec<3.0>);
    let d = scaled(Vec<1.0, 2.0, 3.0>);
    if c.x != 6.0 || d.x != 2.0 || d.y != 5.0 || d.z != 8.0 { ret 4; };
    let wide = Mat<Vec<1.0, 2.0, 3.0>, Vec<4.0, 5.0, 6.0>>;
    let tall = Mat<Vec<1.0, 2.0>, Vec<3.0, 4.0>, Vec<5.0, 6.0>>;
    let f1 = filled(Vec<0.0>);
    let f3 = filled(Vec<0.0, 0.0, 0.0>);
    if f1.x != 1.0 || f3.z != 1.0 { ret 10; };
    let row_ones = map each row of wide { fill 1.0 };
    if row_ones[1].z != 1.0 { ret 11; };
    let w = nested(wide);
    let t = nested(tall);
    let r = rows(wide);
    if w[1].z != 7.0 || t[2].y != 7.0 || r[1].z != 12.0 { ret 5; };
    let i32[3] arr = {1, 2, 3};
    let arr2 = map each x of arr indexed by i { x + as<i32>(i) };
    if arr2[0] != 1 || arr2[1] != 3 || arr2[2] != 5 || arr[1] != 2 { ret 6; };
    let fvec2[2] vectors = {Vec<1.0, 2.0>, Vec<3.0, 4.0>};
    let doubled = map each v of vectors { map each x of v { x * 2.0 } };
    if doubled[1].y != 8.0 || vectors[1].y != 4.0 { ret 7; };
    let x = Vec<7.0, 8.0>;
    let i = as<u32>(99);
    let shadow = map each x of x indexed by i { x + as<float>(i) };
    if shadow.y != 9.0 || x.y != 8.0 || i != 99 { ret 8; };
    0
}
